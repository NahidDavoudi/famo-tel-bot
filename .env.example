# Telegram
TELEGRAM_BOT_TOKEN=
# Optional: relay/custom Bot API base URL (blank = https://api.telegram.org)
TELEGRAM_API_URL=

# Webhook
BOT_WEBHOOK_URL=
# Optional: if set, the webhook should validate X-Telegram-Bot-Api-Secret-Token
BOT_WEBHOOK_SECRET=

# Famo API
# Base URL WITHOUT /api/v1 (the client appends it)
FAMO_API_URL=https://api.famoacademy.ir
# Same value as the API server's BOT_SERVICE_KEY (sent as X-Bot-Key)
FAMO_API_TOKEN=

# Aliases accepted by Config (use either these or the FAMO_* names above)
# API_BASE_URL=
# BOT_SERVICE_KEY=

# JWT (used by App\Services\JwtService)
JWT_SECRET=

# Storage / logs (prefer a path OUTSIDE the web root in production)
BOT_STORAGE_DIR=
# Bot runtime log (Monolog, daily rotation); defaults to <root>/storage/logs/bot-YYYY-MM-DD.log
# BOT_LOG_FILE=
