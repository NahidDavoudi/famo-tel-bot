# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Famo API base URL WITHOUT /api/v1 (required)
FAMO_API_URL=https://api.famoacademy.ir

# Service key sent as X-Bot-Key; must match the API server's BOT_SERVICE_KEY (required)
BOT_SERVICE_KEY=

# Site login page hosting the Telegram Login Widget (required)
BOT_LOGIN_URL=

# Optional: if set, the webhook validates X-Telegram-Bot-Api-Secret-Token
BOT_WEBHOOK_SECRET=

# Optional: state database directory; defaults to <root>/storage
BOT_STORAGE_DIR=

# Optional: Monolog log file; defaults to <root>/storage/logs/bot.log
BOT_LOG_FILE=
