#!/usr/bin/env php
<?php

require_once __DIR__ . '/vendor/autoload.php';

use Dotenv\Dotenv;
use GuzzleHttp\Client;
use GuzzleHttp\RequestOptions;
use Telegram\Bot\Api;
use Telegram\Bot\HttpClients\GuzzleHttpClient;

$dotenv = Dotenv::createImmutable(__DIR__);
$dotenv->load();

$token = $_ENV['TELEGRAM_BOT_TOKEN'] ?? '';
if (!$token) {
    echo "ERROR: TELEGRAM_BOT_TOKEN not set in .env\n";
    exit(1);
}

function createApi(): Api
{
    global $token;
    $httpClient = null;

    if (!empty($_ENV['TELEGRAM_PROXY'])) {
        $guzzle = new Client([RequestOptions::PROXY => $_ENV['TELEGRAM_PROXY']]);
        $httpClient = new GuzzleHttpClient($guzzle);
    }

    $baseBotUrl = null;
    if (!empty($_ENV['TELEGRAM_API_URL'])) {
        $baseBotUrl = rtrim($_ENV['TELEGRAM_API_URL'], '/') . '/bot';
    }

    return new Api($token, false, $httpClient, $baseBotUrl);
}

function status(Api $bot): void
{
    try {
        $me = $bot->getMe();
        echo "Bot Name: " . ($me['first_name'] ?? 'N/A') . "\n";
        echo "Username: @" . ($me['username'] ?? 'N/A') . "\n";
        echo "ID: " . ($me['id'] ?? 'N/A') . "\n";
    } catch (\Throwable $e) {
        echo "ERROR: Cannot reach Telegram API (getMe failed)\n";
        echo "  " . $e->getMessage() . "\n";
        if (!empty($_ENV['TELEGRAM_PROXY'])) {
            echo "  Proxy: " . $_ENV['TELEGRAM_PROXY'] . "\n";
        }
        if (!empty($_ENV['TELEGRAM_API_URL'])) {
            echo "  API URL: " . $_ENV['TELEGRAM_API_URL'] . "\n";
        }
        return;
    }

    echo "\n--- Webhook Info ---\n";
    try {
        $info = $bot->getWebhookInfo();
        $url = $info['url'] ?? '(not set)';
        echo "URL: " . $url . "\n";
        echo "Pending Updates: " . ($info['pending_update_count'] ?? 0) . "\n";
        echo "Max Connections: " . ($info['max_connections'] ?? 'N/A') . "\n";
        echo "Allowed Updates: " . json_encode($info['allowed_updates'] ?? []) . "\n";
        if (!empty($info['last_error_date'])) {
            echo "Last Error Date: " . date('Y-m-d H:i:s', $info['last_error_date']) . "\n";
        }
        if (!empty($info['last_error_message'])) {
            echo "Last Error: " . $info['last_error_message'] . "\n";
        }
        if (!empty($info['last_synchronization_error_date'])) {
            echo "Last Sync Error: " . date('Y-m-d H:i:s', $info['last_synchronization_error_date']) . "\n";
        }
        if (!empty($info['custom_certificate_hash'])) {
            echo "Custom Cert Hash: " . $info['custom_certificate_hash'] . "\n";
        }
        if (!empty($info['ip_address'])) {
            echo "IP Address: " . $info['ip_address'] . "\n";
        }
        $hasSecret = !empty($info['has_custom_certificate']);
        echo "Has Custom Cert: " . ($hasSecret ? 'yes' : 'no') . "\n";
        if (!empty($info['secret_token'])) {
            echo "Secret Token: " . $info['secret_token'] . "\n";
        }

        if ($url && $url !== '' && strpos($url, 'https://') === 0) {
            echo "\n--- Webhook URL Accessibility ---\n";
            $ch = curl_init($url);
            curl_setopt_array($ch, [
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_TIMEOUT => 10,
                CURLOPT_CONNECTTIMEOUT => 5,
                CURLOPT_NOBODY => true,
                CURLOPT_HEADER => true,
            ]);
            $response = curl_exec($ch);
            $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            $curlError = curl_error($ch);
            curl_close($ch);

            if ($curlError) {
                echo "Accessibility: FAIL - $curlError\n";
            } elseif ($httpCode >= 200 && $httpCode < 400) {
                echo "Accessibility: OK (HTTP $httpCode)\n";
            } else {
                echo "Accessibility: WARNING (HTTP $httpCode)\n";
            }
        }
    } catch (\Throwable $e) {
        echo "ERROR fetching webhook info: " . $e->getMessage() . "\n";
    }
}

function setWebhook(Api $bot): void
{
    $url = $_ENV['BOT_WEBHOOK_URL'] ?? '';
    if (!$url) {
        echo "ERROR: BOT_WEBHOOK_URL not set in .env\n";
        exit(1);
    }

    $params = [
        'url' => $url,
        'max_connections' => 40,
        'allowed_updates' => ['message', 'callback_query'],
    ];

    if (!empty($_ENV['BOT_WEBHOOK_SECRET'])) {
        $params['secret_token'] = $_ENV['BOT_WEBHOOK_SECRET'];
    }

    try {
        $result = $bot->setWebhook($params);
        echo "Webhook set successfully!\n";
        echo "URL: $url\n";
        if (!empty($params['secret_token'])) {
            echo "Secret Token: " . $params['secret_token'] . "\n";
        }
    } catch (\Throwable $e) {
        echo "ERROR setting webhook: " . $e->getMessage() . "\n";
        exit(1);
    }

    echo "\n";
    status($bot);
}

function deleteWebhook(Api $bot, bool $dropPending): void
{
    try {
        $params = [];
        if ($dropPending) {
            $params['drop_pending_updates'] = true;
        }
        $bot->deleteWebhook($params);
        echo "Webhook deleted successfully!\n";
        if ($dropPending) {
            echo "Pending updates were dropped.\n";
        }
    } catch (\Throwable $e) {
        echo "ERROR deleting webhook: " . $e->getMessage() . "\n";
        exit(1);
    }

    echo "\n";
    status($bot);
}

function test(Api $bot, string $chatId): void
{
    try {
        $result = $bot->sendMessage([
            'chat_id' => $chatId,
            'text' => 'This is a test message from bot-admin. If you see this, sending works!',
        ]);
        echo "Message sent successfully to $chatId\n";
        echo "Message ID: " . ($result['message_id'] ?? 'N/A') . "\n";
    } catch (\Throwable $e) {
        echo "ERROR sending message: " . $e->getMessage() . "\n";
        exit(1);
    }
}

// --- CLI Entry Point ---
$command = $argv[1] ?? 'help';

switch ($command) {
    case 'status':
        status(createApi());
        break;

    case 'set-webhook':
        setWebhook(createApi());
        break;

    case 'delete-webhook':
        $dropPending = in_array('--drop-pending', $argv, true);
        deleteWebhook(createApi(), $dropPending);
        break;

    case 'test':
        $chatId = $argv[2] ?? '';
        if (!$chatId) {
            echo "Usage: bot-admin test <chat_id>\n";
            exit(1);
        }
        test(createApi(), $chatId);
        break;

    default:
        echo "Usage: bot-admin <command> [options]\n\n";
        echo "Commands:\n";
        echo "  status               Show bot and webhook status\n";
        echo "  set-webhook          Set webhook URL from BOT_WEBHOOK_URL in .env\n";
        echo "  delete-webhook       Delete webhook\n";
        echo "    --drop-pending     Drop pending updates\n";
        echo "  test <chat_id>       Send a test message to a chat\n";
        break;
}